<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========== Basic project settings ========== -->
	<PropertyGroup>
		<!-- Target a single framework (adjust if you need multi-targeting) -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- Or use <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks> if needed -->

		<RestoreProjectStyle>PackageReference</RestoreProjectStyle>
	</PropertyGroup>

	<!-- ========== NuGet package metadata ========== -->
	<PropertyGroup>
		<PackageId>GovukNotify</PackageId>
		<!-- or "GovukNotify.Custom" to avoid confusion -->
		<Version>9.4.0-custom</Version>
		<Authors>GOV.UK Notify / WORTH</Authors>
		<Description>Customised GOV.UK Notify client for our internal use.</Description>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>See https://github.com/alphagov/notifications-net-client/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<PackageTags>notify;govuk;letter;email;sms</PackageTags>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<!-- set to true if you want a package on every build -->
	</PropertyGroup>

	<!-- ========== XML documentation ========== -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\GovukNotify.xml</DocumentationFile>
		<NoWarn>1591</NoWarn>
		<!-- suppress missing XML comment warnings -->
	</PropertyGroup>

	<!-- ========== Dependencies ========== -->
	<ItemGroup>
		<!-- JWT with version range (latest in 11.x) -->
		<PackageReference Include="JWT" Version="[11,12)" />
		<!-- Newtonsoft.Json with a secure version (13.0.4+) -->
		<PackageReference Include="Newtonsoft.Json" Version="[13.0.4,14)" />
	</ItemGroup>

	<!-- Additional dependency only for .NET Framework 4.6.2 (if you target it) -->
	<ItemGroup Condition=" '$(TargetFramework)' == 'net462' ">
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
	</ItemGroup>

</Project>